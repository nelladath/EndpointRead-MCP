# Microsoft Graph API Configuration
# Copy this file to .env and fill in your values

# Azure AD App Registration
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# Authentication mode:
# app       -> app-only token from CLIENT_ID/CLIENT_SECRET (default)
# delegated -> user sign-in token only (device-code flow)
# hybrid    -> app token for Graph, with optional first-layer user sign-in gate
AUTH_MODE=app

# First-layer user sign-in gate (recommended with AUTH_MODE=hybrid)
# true  -> require user interactive sign-in before app auth is used
# false -> do not require user sign-in gate
REQUIRE_USER_LOGIN=false

# Delegated login scopes for interactive sign-in (comma-separated)
USER_AUTH_SCOPES=User.Read

# Interactive user login mode:
# device_code -> show code + login.microsoft.com/device
# browser     -> open browser sign-in window directly (username/password/MFA)
INTERACTIVE_LOGIN_MODE=device_code

# Optional token cache path for interactive sign-in
# TOKEN_CACHE_PATH=E:\\MCP\\intune-mcp-server\\.msal_token_cache.bin

# Optional: Graph API endpoint (default is global)
# GRAPH_ENDPOINT=https://graph.microsoft.com/v1.0
# Use beta for newer features:
# GRAPH_ENDPOINT=https://graph.microsoft.com/beta

